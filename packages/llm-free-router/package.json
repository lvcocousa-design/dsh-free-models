{
  "name": "@dsh-free-models/llm-free-router",
  "version": "0.1.0",
  "description": "A dsh LLM adapter that serves one virtual route, free-auto, and falls back across free-tier providers when one runs out.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@dsh-free-models/core": "workspace:*",
    "@dsh-free-models/presets": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/cosmokit": "~1.9.0",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvcocousa-design/dsh-free-models.git",
    "directory": "packages/llm-free-router"
  },
  "homepage": "https://github.com/lvcocousa-design/dsh-free-models#readme",
  "bugs": {
    "url": "https://github.com/lvcocousa-design/dsh-free-models/issues"
  },
  "author": "dsh-free-models maintainers",
  "private": true
}
