{
  "name": "@dsh-free-models/client-ui",
  "version": "0.1.0",
  "description": "Settings page for the dsh free-models router: fallback order, per-provider status and usage, billing confirmation.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs"
  },
  "files": [
    "lib",
    "src",
    "build.mjs",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-locale": "next",
    "@deepseek-ai/dsh-client-ui-settings": "next",
    "@deepseek-ai/dsh-client-ui-renderer": "next",
    "@deepseek-ai/dsh-client-ui-slots": "next",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "esbuild": "^0.28",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  }
}
